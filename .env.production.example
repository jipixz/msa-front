# Copia este archivo a .env.production.local (ignorado por git) y ajusta los valores.
# Solo las variables VITE_* se inyectan en el build, y quedan visibles en el JavaScript público:
# no pongas aquí nada que deba ser secreto.

# Backend Node (API REST y WebSockets). La "/" final se ignora.
VITE_API_URL=https://msabackend.jipixz.com

# Servicio de predicciones (FastAPI)
VITE_PREDICTIONS_API_URL=https://fastapimsa.jipixz.com

# URL del servidor de Better Auth. Si se omite, se usa el mismo origen que el front.
# VITE_BETTER_AUTH_URL=https://msafront.jipixz.com

# OpenWeather (predicciones/mapa del clima)
VITE_OPENWEATHER_API_KEY=tu_api_key
